# ---------------------------------------------------------------------------
# Workstation
# ---------------------------------------------------------------------------
# IP or hostname of the workstation. A DHCP reservation is strongly recommended.
WAKER_TARGET_HOST=192.168.1.50
WAKER_TARGET_PORT=11434
# MAC of the onboard 5 GbE NIC (Realtek RTL8126). Read it with: ip link
WAKER_MAC=aa:bb:cc:dd:ee:ff

# ---------------------------------------------------------------------------
# Wake on LAN
# ---------------------------------------------------------------------------
# Subnet broadcast of the LAN the workstation sits on, e.g. 192.168.1.255.
# Multiple entries allowed, comma separated. Add the workstation IP as a
# unicast fallback if your switch keeps a static ARP entry.
WAKER_WOL_TARGETS=192.168.1.255
WAKER_WOL_PORTS=9,7
WAKER_WAKE_TIMEOUT=3m
WAKER_WOL_REPEAT=15s
WAKER_PROBE_INTERVAL=2s
# A sleeping host does not refuse the TCP probe, it stays silent. Cached model
# lists are therefore answered after this timeout. LAN round trips are far
# below 100 ms, so going lower is fine.
WAKER_PROBE_TIMEOUT=2s

# How often the cached model list is refreshed while the workstation is up.
# Clients listing models never wake the machine; see README.
WAKER_CATALOG_REFRESH=5m

# ---------------------------------------------------------------------------
# Netboot (variant A: iPXE decides which OS boots)
# ---------------------------------------------------------------------------
# IP of THIS server, as reachable from the workstation firmware.
WAKER_SERVER_IP=192.168.1.10
# URL prefix iPXE uses for kernel and initrd. Plain HTTP and an IP on purpose:
# iPXE firmware has no TLS, and DNS should not be a boot dependency. The port
# is Traefik's netboot entrypoint (see docker-compose.yml).
WAKER_NETBOOT_BASE_URL=http://192.168.1.10:8080/netboot
WAKER_DEFAULT_MODE=ai
WAKER_RESET_MODE_AFTER_BOOT=true

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Bearer token for the AI proxy. There is no Authentik in front of ai.$DOMAIN,
# so this is the only thing guarding it. Leave empty only while testing.
WAKER_API_KEY=
# Optional second lock for the admin endpoints, on top of Authentik.
WAKER_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Compose / Traefik
# ---------------------------------------------------------------------------
DOMAIN=example.ch
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
# Middleware name of your Authentik forward-auth, as configured in Traefik.
AUTHENTIK_MIDDLEWARE=authentik@file
# Plain-HTTP entrypoint for iPXE. Must exist in the static Traefik config.
TRAEFIK_NETBOOT_ENTRYPOINT=netboot
# Only used if you uncomment the ports block in docker-compose.yml.
WAKER_LAN_PORT=8080
