# ---------------------------------------------------------------------------
# Workstation
# ---------------------------------------------------------------------------
# IP or hostname of the workstation. A DHCP reservation is strongly recommended.
WAKER_TARGET_HOST=192.168.1.50
WAKER_TARGET_PORT=11434
# MAC of the onboard NIC (Realtek RTL8126). Read it with: ip link
WAKER_MAC=aa:bb:cc:dd:ee:ff

# ---------------------------------------------------------------------------
# Wake on LAN
# ---------------------------------------------------------------------------
# Subnet broadcast of the LAN the workstation sits on, e.g. 192.168.1.255.
# Multiple entries allowed, comma separated.
WAKER_WOL_TARGETS=192.168.1.255
WAKER_WOL_PORTS=9,7
# Resume from suspend takes seconds. The timeout leaves room for a full boot
# in case the machine was powered off instead.
WAKER_WAKE_TIMEOUT=3m
WAKER_WOL_REPEAT=15s
WAKER_PROBE_INTERVAL=2s
# A sleeping host does not refuse the TCP probe, it stays silent. Cached model
# lists are therefore answered after this timeout. LAN round trips are far
# below 100 ms, so going lower is fine.
WAKER_PROBE_TIMEOUT=2s
# How often the cached model list is refreshed while the workstation is up.
WAKER_CATALOG_REFRESH=5m

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Bearer token for the API. Nothing else guards ai.$DOMAIN, so set it before
# the first start. Generate with: openssl rand -hex 32
WAKER_API_KEY=
# Optional second lock for the admin endpoints, on top of Authentik. Traefik
# adds it to every request that passed Authentik, so the browser needs nothing.
# It only locks out callers that reach port 8081 without Traefik, e.g. other
# containers on the proxy network. The Homepage widget is such a caller and has
# to send it as X-Waker-Token header. Generate with: openssl rand -hex 32
WAKER_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Compose / Traefik
# ---------------------------------------------------------------------------
# Base domain without the service prefix. The routers become ai.$DOMAIN and
# waker.$DOMAIN, so DOMAIN=home.example.org serves ai.home.example.org.
DOMAIN=home.example.org
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
# Authentik forward-auth middleware, spelled exactly like on your other protected
# services, provider suffix included (@docker or @file). To look it up:
#   docker ps -q | xargs docker inspect --format '{{.Name}} {{json .Config.Labels}}' | tr ',' '\n' | grep -E '^/|middlewares'
AUTHENTIK_MIDDLEWARE=authentik@docker
